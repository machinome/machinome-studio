#!/usr/bin/env bash
# Copyright (C) 2023-2026 Luis Henrique Cassis Fagundes
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# setup — bootstrap Machinome Studio in this checkout.
#
#   scripts/setup
#
# Creates the virtualenv at .venv/, installs the OpenSpec CLI the studio
# refuses to start without, builds the studio's floor frontend from source,
# installs "machinome[viewer]" and the viewer's [snapshot] extra with the
# Chromium its headless capture needs, and installs the studio itself
# editable into the venv.
#
# The browser viewer is not part of machinome. It is machinome-viewer, a
# separate AGPL-3.0-or-later package the Apache-2.0 framework installs as its
# [viewer] extra and reaches only as a separate process; the studio floor
# serves the bundle that package carries. Both wheels ship everything
# prebuilt, so node/npm is needed only for the studio's own frontend and the
# OpenSpec CLI, alongside Python and OpenSCAD.
#
# Idempotent — re-run freely.

set -euo pipefail

SHOP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$SHOP_ROOT/.venv"
VENV_PYTHON="$VENV/bin/python"

say() { echo "setup: $*"; }
die() { echo "setup: $*" >&2; exit 1; }

[ "$#" -eq 0 ] || die "usage: scripts/setup"

ensure_venv() {
  if [ ! -x "$VENV_PYTHON" ]; then
    say "creating venv at $VENV"
    python3 -m venv "$VENV"
  fi
  # Invoking the module through the venv interpreter survives a checkout
  # directory rename even when generated pip entry-point shebangs are stale.
  "$VENV_PYTHON" -m pip install --quiet --upgrade pip
}

check_system_deps() {
  command -v openscad >/dev/null 2>&1 \
    || say "WARNING: openscad not found on PATH — STL rendering and" \
           "snapshots will not work until it is installed"
  command -v git >/dev/null 2>&1 || die "git is required"
}

# The studio refuses to start without this: it is how a project records the
# design of its parts, and a studio that cannot record one loses it silently.
ensure_openspec_cli() {
  if command -v openspec >/dev/null 2>&1; then
    return
  fi
  command -v npm >/dev/null 2>&1 \
    || die "the openspec CLI is required and needs node/npm to install"
  say "installing the openspec CLI"
  npm install -g @fission-ai/openspec \
    || die "could not install @fission-ai/openspec — install it manually" \
           "(npm install -g @fission-ai/openspec) and re-run"
}

# The floor's browser surface is built, not committed: floor/static is
# generated output (Vite empties and rewrites it on every build), so a fresh
# checkout has no UI until this runs. The floor is the only way to open a
# project.
build_floor_frontend() {
  command -v npm >/dev/null 2>&1 \
    || die "npm is required to build the studio floor browser surface" \
           "(floor/static is generated, not committed)"
  say "building the studio floor frontend"
  (cd "$SHOP_ROOT/floor/frontend" \
     && npm install --no-audit --no-fund && npm run build)
}

install_machinome() {
  say "installing machinome with its browser viewer from PyPI"
  "$VENV_PYTHON" -m pip install --upgrade "machinome[viewer]" rtree scipy
  "$VENV_PYTHON" -m pip install --upgrade "machinome-viewer[snapshot]"
}

# The studio photographs every project it opens through
# `machinome snapshot --renderer web`, so the hub's model previews need the
# viewer's headless capture: Playwright, which the [snapshot] extra installs,
# and the Chromium build that exact Playwright expects. Without both, every
# preview render fails and the hub shows projects without a picture.
ensure_snapshot_browser() {
  say "downloading the Chromium build the snapshot renderer needs"
  "$VENV_PYTHON" -m playwright install chromium || {
    say "WARNING: could not download Chromium — hub model previews will not"
    say "         render until you run: $VENV_PYTHON -m playwright install chromium"
    return 0
  }
}

install_studio() {
  say "installing Machinome Studio editable from $SHOP_ROOT"
  "$VENV_PYTHON" -m pip install --editable "$SHOP_ROOT"
}

ensure_venv
check_system_deps
ensure_openspec_cli
build_floor_frontend
install_machinome
ensure_snapshot_browser
install_studio

say "done. Activate with: source $VENV/bin/activate"
say "open the project hub with: python -m floor.orchestrator --projects-dir PATH"
