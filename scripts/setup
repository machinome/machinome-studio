#!/usr/bin/env bash
#
# setup — bootstrap the shop workspace, in one of two tiers.
#
#   scripts/setup             tier 1 (plain): venv + pip install solid-node
#   scripts/setup dev [ref]   tier 2 (development): the framework as a git
#                             working copy (latest release tag by default,
#                             or the given tag/branch/sha), editable
#                             install, frontend built from source
#
# Tier 1 is enough to BUILD projects with the shop: the wheel ships the
# prebuilt viewer and widget. Both tiers build the shop's own floor
# frontend from source, so node/npm is required alongside Python and
# OpenSCAD. Tier 2 is the contributor bench: the framework as a working
# copy for framework development, and the frontend
# (viewer app + widget) built from source so it can be worked on — the
# widget is the framework's largest growing surface, and the dev bench
# must never constrain it.
#
# Running `setup dev` on a tier-1 workspace upgrades it in place (the
# pip-installed solid-node is replaced by the editable working copy).
# Both tiers are idempotent — re-run freely.
#
# Env overrides:
#   SOLID_NODE_REPO   clone URL (default: the upstream framework repo;
#                     point it at your fork to develop against that)

set -euo pipefail

SHOP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$SHOP_ROOT/.venv"
VENV_PYTHON="$VENV/bin/python"
FRAMEWORK_DIR="$SHOP_ROOT/solid-node"
FRAMEWORK_REPO="${SOLID_NODE_REPO:-https://github.com/LibreSolid/solid-node.git}"

say() { echo "setup: $*"; }
die() { echo "setup: $*" >&2; exit 1; }

ensure_venv() {
  if [ ! -x "$VENV_PYTHON" ]; then
    say "creating venv at $VENV"
    python3 -m venv "$VENV"
  fi
  # Invoking the module through the venv interpreter survives a workspace
  # directory rename even when generated pip entry-point shebangs are stale.
  "$VENV_PYTHON" -m pip install --quiet --upgrade pip
}

check_system_deps() {
  command -v openscad >/dev/null 2>&1 \
    || say "WARNING: openscad not found on PATH — STL rendering and" \
           "snapshots will not work until it is installed"
  command -v git >/dev/null 2>&1 || die "git is required"
}

# The shop floor's browser surface is built, not committed: floor/static is
# generated output (Vite empties and rewrites it on every build), so a fresh
# checkout has no UI until this runs. Both tiers need it — the floor is the
# only way to open a project.
build_floor_frontend() {
  command -v npm >/dev/null 2>&1 \
    || die "npm is required to build the shop floor browser surface" \
           "(floor/static is generated, not committed)"
  say "building the shop floor frontend"
  (cd "$SHOP_ROOT/floor/frontend" \
     && npm install --no-audit --no-fund && npm run build)
}

tier1() {
  say "tier 1 (plain): installing solid-node from PyPI"
  "$VENV_PYTHON" -m pip install --upgrade solid-node rtree scipy
  say "done. Activate with: source $VENV/bin/activate"
  say "upgrade to the contributor bench anytime: scripts/setup dev"
}

latest_tag() {  # in $FRAMEWORK_DIR; empty if the repo has no tags
  git -C "$FRAMEWORK_DIR" tag --sort=-v:refname | head -1
}

tier2() {
  local ref="${1:-}"

  if [ ! -d "$FRAMEWORK_DIR/.git" ]; then
    say "cloning framework: $FRAMEWORK_REPO -> $FRAMEWORK_DIR"
    git clone "$FRAMEWORK_REPO" "$FRAMEWORK_DIR"
  else
    say "framework clone present, fetching"
    git -C "$FRAMEWORK_DIR" fetch --tags --prune
  fi

  if [ -z "$ref" ]; then
    ref="$(latest_tag)"
    if [ -z "$ref" ]; then
      say "no release tags found — staying on the default branch"
    fi
  fi
  if [ -n "$ref" ]; then
    say "checking out $ref"
    git -C "$FRAMEWORK_DIR" checkout --quiet "$ref"
  fi

  say "tier 2 (development): editable install of the working copy"
  "$VENV_PYTHON" -m pip uninstall --quiet --yes solid-node 2>/dev/null || true
  "$VENV_PYTHON" -m pip install --editable "$FRAMEWORK_DIR"
  "$VENV_PYTHON" -m pip install rtree scipy

  # Frontend from source: viewer app and widget. Needs npm; without it
  # the bench still works for Python-side development, but the web
  # viewer and export widget are unavailable until npm is installed.
  if command -v npm >/dev/null 2>&1; then
    say "building the viewer app"
    (cd "$FRAMEWORK_DIR/solid_node/viewers/web/app" \
       && npm install --no-audit --no-fund && npm run build)
    say "building the widget"
    (cd "$FRAMEWORK_DIR/solid_node/viewers/widget" \
       && npm install --no-audit --no-fund && npm run build)
  else
    say "WARNING: npm not found — viewer app and widget not built."
    say "         Install node/npm and re-run: scripts/setup dev"
  fi

  say "done. Framework working copy: $FRAMEWORK_DIR ($(git -C "$FRAMEWORK_DIR" describe --tags --always))"
  say "framework worktrees: $FRAMEWORK_DIR/WTs/<name>"
  say "create one with: scripts/dev-env <name> setup"
}

ensure_venv
check_system_deps
build_floor_frontend
case "${1:-plain}" in
  plain) tier1 ;;
  dev)   tier2 "${2:-}" ;;
  *)     die "usage: scripts/setup [dev [ref]]" ;;
esac
